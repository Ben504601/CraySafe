<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Header card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:id="@+id/tvSeverityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CRITICAL"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/white"
                    android:background="@color/critical" />

                <TextView
                    android:id="@+id/tvParameter"
                    style="@style/Text.H1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temperature"
                    android:layout_marginTop="@dimen/space_md" />

                <TextView
                    android:id="@+id/tvTankName"
                    style="@style/Text.BodyMuted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Main Tank"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvDate"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oct 7, 2026 · 2:30 PM"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The Issue section -->
        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THE ISSUE"
            android:textColor="@color/text_tertiary"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvHeadline"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_md"
                android:text="" />
        </com.google.android.material.card.MaterialCardView>

        <!-- What to Do section -->
        <TextView
            android:id="@+id/labelAdvice"
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WHAT TO DO"
            android:textColor="@color/text_tertiary"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAdvice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvAdvice"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_md"
                android:lineSpacingMultiplier="1.3"
                android:text="" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>