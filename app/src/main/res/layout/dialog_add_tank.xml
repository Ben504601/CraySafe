<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <!-- ─── Header icon ─── -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_add"
        android:background="@drawable/bg_pill_primary"
        android:padding="12dp"
        app:tint="@color/primary"
        android:layout_gravity="start"
        android:contentDescription="Pair tank" />

    <!-- ─── Title ─── -->
    <TextView
        style="@style/Text.H2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pair a new tank"
        android:layout_marginTop="@dimen/space_md" />

    <!-- ─── Subtitle ─── -->
    <TextView
        style="@style/Text.BodyMuted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the Product ID printed on your CraySafe hardware receipt."
        android:layout_marginTop="@dimen/space_xs" />

    <!-- ─── Product ID field ─── -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilProductId"
        style="@style/TextInput.Base"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Product ID"
        app:helperText="Example: T001 or 001"
        app:errorEnabled="true"
        android:layout_marginTop="@dimen/space_lg">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etProductId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLines="1"
            android:textSize="16sp"
            android:letterSpacing="0.05" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- ─── Info tip ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/info_bg"
        android:padding="@dimen/space_sm"
        android:layout_marginTop="@dimen/space_md"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_help"
            app:tint="@color/primary"
            android:contentDescription="Tip" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_sm"
            android:text="You can find the Product ID on the box or the paper receipt that came with your device."
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- ─── Buttons ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="@dimen/space_lg">

        <Button
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnPair"
            style="@style/Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text="Pair tank"
            android:minWidth="120dp" />
    </LinearLayout>

    <!-- ─── Loading overlay (covers the whole dialog while pairing) ─── -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginTop="@dimen/space_sm" />
</LinearLayout>