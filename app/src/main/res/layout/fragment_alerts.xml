<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Header (Title & Subtitle ONLY) -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md"
        android:paddingBottom="@dimen/space_sm"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/Text.H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alerts" />

        <TextView
            android:id="@+id/tvUnreadCount"
            style="@style/Text.BodyMuted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No unread alerts"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Filter Chips (Moved OUT of header, now a direct child of ConstraintLayout) -->
    <HorizontalScrollView
        android:id="@+id/filterScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:paddingHorizontal="@dimen/space_md"
        android:scrollbars="none"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:singleLine="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="@dimen/space_sm">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Alerts"
                android:checkable="true"
                android:checked="true"
                android:textAllCaps="false"
                android:background="@drawable/bg_chip_selector"
                android:textColor="@color/bg_chip_text_selector"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUnread"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unread"
                android:checkable="true"
                android:textAllCaps="false"
                android:background="@drawable/bg_chip_selector"
                android:textColor="@color/bg_chip_text_selector"
                app:chipStrokeWidth="0dp" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Alerts list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAlerts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingBottom="@dimen/space_md"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/filterScroll"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/emptyStateLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_xl"
        app:layout_constraintTop_toBottomOf="@id/filterScroll"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_notifications"
            android:alpha="0.3"
            app:tint="@color/safe"
            android:contentDescription="No alerts" />

        <TextView
            style="@style/Text.H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All clear"
            android:layout_marginTop="@dimen/space_md" />

        <TextView
            style="@style/Text.BodyMuted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your tanks are healthy.\nWe'll notify you when something needs attention."
            android:gravity="center"
            android:layout_marginTop="@dimen/space_xs" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/filterScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Error State -->
    <include
        android:id="@+id/errorStateLayout"
        layout="@layout/view_error_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/filterScroll"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>