<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/surface_variant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Category pill -->
        <TextView
            android:id="@+id/tvCategory"
            style="@style/StatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hardware"
            android:textColor="@color/primary"
            android:background="@drawable/bg_pill_primary" />

        <!-- Issue title -->
        <TextView
            android:id="@+id/tvIssueTitle"
            style="@style/Text.H3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My sensor is reading odd values"
            android:layout_marginTop="@dimen/space_sm" />

        <!-- Solution (collapsed by default) -->
        <TextView
            android:id="@+id/tvSolution"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Steps to fix..."
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone" />

        <!-- Expand hint -->
        <TextView
            android:id="@+id/tvHint"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to expand"
            android:layout_marginTop="@dimen/space_sm" />

        <!-- Feedback Row (Initially Hidden) -->
        <LinearLayout
            android:id="@+id/feedbackLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/space_md"
            android:visibility="gone">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Was this helpful?" />

            <!-- Thumbs Up -->
            <ImageButton
                android:id="@+id/btnHelpful"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_thumb_up"
                app:tint="@color/text_tertiary" />

            <TextView
                android:id="@+id/tvHelpfulCount"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:text="0" />

            <!-- Thumbs Down -->
            <ImageButton
                android:id="@+id/btnUnhelpful"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_thumb_down"
                app:tint="@color/text_tertiary" />

            <TextView
                android:id="@+id/tvUnhelpfulCount"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>